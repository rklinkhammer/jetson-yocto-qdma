# L4TLauncher configuration file generated by OE4T
MENU TITLE L4T boot options
DEFAULT primary
LABEL primary
	MENU LABEL primary
	LINUX /boot/Image
	FDT /boot/dtb/tegra234-p3768-0000+p3767-0000-nv-super.dtb
	INITRD /boot/initrd
	APPEND ${cbootargs} mminit_loglevel=4 console=ttyTCU0,115200 firmware_class.path=/etc/firmware fbcon=map:0 video=efifb:off console=tty0 efi=runtime nvme.use_threaded_interrupts=1 pci=pcie_bus_perf






